DISCORD_TOKEN=
DEV_GUILD_ID=
DATABASE_PATH=data/archipelabot.db
LOG_LEVEL=INFO
TIMEZONE=Europe/Paris
# ARCHIPELAGO_PATH=  # already set in the Docker image; an Archipelago source folder with its .venv, or a folder of them
# HOST_ADDRESS=  # host name or IP players use to reach this machine, to host games with /partie lancer
# HOST_PORTS=38281-38300  # ports for hosted games, published in compose.yaml
# HOST_CERT=  # certificate for HOST_ADDRESS (e.g. Let's Encrypt fullchain.pem), readable by the bot: hosted games then
# HOST_CERT_KEY=  # use wss://, which browser games need; and its private key (privkey.pem)
