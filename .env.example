DISCORD_TOKEN=
DEV_GUILD_ID=
DATABASE_PATH=data/archipelabot.db
LOG_LEVEL=INFO
TIMEZONE=Europe/Paris
# ARCHIPELAGO_PATH=  # already set in the Docker image; an Archipelago source folder with its .venv, or a folder of them
